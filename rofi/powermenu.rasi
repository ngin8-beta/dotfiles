/*
 * Nord Powermenu Theme for Rofi
 */

* {
    nord0: #2E3440;
    nord1: #3B4252;
    nord3: #4C566A;
    nord4: #D8DEE9;
    nord6: #ECEFF4;
    nord8: #88C0D0;
    nord11: #BF616A;

    background-color: transparent;
    text-color: @nord4;
    font: "JetBrainsMono Nerd Font 14";
}

window {
    background-color: @nord0;
    border: 3px;
    border-color: @nord3;
    border-radius: 16px;
    padding: 30px;
    width: 500px;
}

mainbox {
    children: [message, listview];
    spacing: 20px;
}

message {
    padding: 10px;
    border-radius: 8px;
    background-color: @nord1;
}

textbox {
    horizontal-align: 0.5;
    text-color: @nord8;
}

listview {
    columns: 1;
    lines: 5;
    spacing: 10px;
    cycle: true;
}

element {
    padding: 15px 20px;
    border-radius: 10px;
    spacing: 15px;
}

element-text {
    text-color: inherit;
}

element selected {
    background-color: @nord3;
    text-color: @nord8;
}
