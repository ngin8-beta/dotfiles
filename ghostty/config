# ===================
# Font Settings
# ===================
font-family = HackGen
font-size = 12

# ===================
# Theme / Colors
# ===================
theme = Nord
background-opacity = 0.9

# ===================
# Window Settings
# ===================
window-padding-x = 8
window-padding-y = 8

# ===================
# Clipboard / Links
# ===================
copy-on-select = clipboard
clipboard-paste-protection = true
link-url = true
keybind = alt+v=paste_from_clipboard

# ===================
# Vim-style Keybindings
# ===================
# Split navigation (Ctrl+hjkl)
keybind = ctrl+h=goto_split:left
keybind = ctrl+j=goto_split:bottom
keybind = ctrl+k=goto_split:top
keybind = ctrl+l=goto_split:right

# Split creation (Ctrl+Shift)
keybind = ctrl+shift+v=new_split:right
keybind = ctrl+shift+s=new_split:down

# Close split
keybind = ctrl+shift+q=close_surface

# Tab navigation
keybind = ctrl+shift+h=previous_tab
keybind = ctrl+shift+l=next_tab

# Help
keybind = ctrl+shift+slash=toggle_command_palette
