# ウィンドウタイトル用のフォント
font pango: Noto Sans Regular 12

# modキーをwinkeyに設定
set $mod Mod4
set $Alt Mod1

# i3 タイルモード
workspace_layout default

##############################
# ウィンドウ関連設定         #
##############################

new_window pixel 1
gaps inner 6
gaps outer 3

# マウス+$modキー:フローティングウィンドウ
floating_modifier $mod

# ウィンドウのサイズ変更
mode "resize" {
# vimライクな操作
# up:ウィンドウの高さを拡大
# down:ウィンドウの高さを縮小
# right:ウィンドウの幅を拡大
# left:ウィンドウの幅を縮小
        bindsym k resize grow height 10 px or 10 ppt
        bindsym j resize shrink width 10 px or 10 ppt
        bindsym h resize grow width 10 px or 10 ppt
        bindsym l resize shrink height 10 px or 10 ppt

        bindsym Up resize grow height 10 px or 10 ppt
        bindsym Down resize shrink height 10 px or 10 ppt
        bindsym Right resize grow width 10 px or 10 ppt
        bindsym Left resize shrink width 10 px or 10 ppt

# 通常モードに戻る：Escape
        bindsym Escape mode "default"
}

# リサイズモードへの切り替え
bindsym $mod+r mode "resize"

# フォーカス変更
bindsym $Alt+Tab exec --no-startup-id  "rofi -show window"
bindsym $Alt+h focus left
bindsym $Alt+s focus left
bindsym $Alt+l focus right
bindsym $Alt+f focus right
bindsym $Alt+k focus up
bindsym $Alt+e focus up
bindsym $Alt+j focus down
bindsym $Alt+d focus down

# ウィンドウ移動
bindsym $Alt+Shift+h move left
bindsym $Alt+Shift+s move left
bindsym $Alt+Shift+l move right
bindsym $Alt+Shift+f move right
bindsym $Alt+Shift+k move up
bindsym $Alt+Shift+e move up
bindsym $Alt+Shift+j move down
bindsym $Alt+Shift+d move down

# ウィンドウ分割: 水平
bindsym $mod+h split h

# ウィンドウ分割: 垂直
bindsym $mod+v split v

# フルスクリーン
bindsym $mod+f fullscreen toggle

# コンテナ周りの設定 使わないのでコメントアウト
## change container layout (stacked, tabbed, toggle split)
#bindsym $mod+s layout stacking
#bindsym $mod+g layout tabbed
#bindsym $mod+e layout toggle split
#
## toggle tiling / floating
#bindsym $mod+Shift+space floating toggle
#
## change focus between tiling / floating windows
#bindsym $mod+space focus mode_toggle
#
## focus the parent container
#bindsym $mod+a focus parent

######################
# ワークスペース設定 #
######################
# ワークスペース間の切り替え
bindsym $mod+Tab workspace next
bindsym $mod+Shift+Tab workspace prev

# 新しいワークスペース作成
bindsym $mod+Shift+n exec --no-startup-id ~/.config/i3/scripts/empty_workspace

# ワークスペース名を設定
set $ws1 "1:𝟭"
set $ws2 "2:𝟐"
set $ws3 "3:𝟑"
set $ws4 "4:𝟒"
set $ws5 "5:𝟓"
set $ws6 "6:𝟔"
set $ws7 "7:𝟕"
set $ws8 "8:"
set $ws9 "9:"
set $ws10 "10:"

# ワークスペースに移動
bindsym $mod+1 workspace $ws1
bindsym $mod+2 workspace $ws2
bindsym $mod+3 workspace $ws3
bindsym $mod+4 workspace $ws4
bindsym $mod+5 workspace $ws5
bindsym $mod+6 workspace $ws6
bindsym $mod+7 workspace $ws7
bindsym $mod+8 workspace $ws8
bindsym $mod+9 workspace $ws9
bindsym $mod+0 workspace $ws10

# focusウィンドウを別ワークスペースに移動
bindsym $mod+Shift+1 move container to workspace $ws1
bindsym $mod+Shift+2 move container to workspace $ws2
bindsym $mod+Shift+3 move container to workspace $ws3
bindsym $mod+Shift+4 move container to workspace $ws4
bindsym $mod+Shift+5 move container to workspace $ws5
bindsym $mod+Shift+6 move container to workspace $ws6
bindsym $mod+Shift+7 move container to workspace $ws7
bindsym $mod+Shift+8 move container to workspace $ws8
bindsym $mod+Shift+9 move container to workspace $ws9
bindsym $mod+Shift+0 move container to workspace $ws10

# 特定のプログラムを特定のワークスペースに割り当て
assign [class="Youtube"] $ws8
assign [class="Twitter"] $ws9
assign [class="Slack"] $ws10
assign [class="discord" instance="discord"] $ws10

# 新しいウィンドウが他のワークスペースに開かれた場合、
# 自動的にそのワークスペースにフォーカスを移動
# for_window [class="Brave"] focus

##############
# コンポジタ #
##############

# ウィンドウの透明化
exec --no-startup-id picom --backend=glx

######################
# 起動時自動起動設定 #
######################

# ポリシーキット認証エージェント
exec --no-startup-id /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1

# デスクトップエントリ
exec --no-startup-id dex --autostart --environment i3

# ディスプレイ設定
exec --no-startup-id ~/.screenlayout/monitor.sh
exec --no-startup-id xrandr --output DP-0 --mode 3840x2160 --rate 144

# 壁紙設定
# 何故か設定が効かないので保留。一旦zshで設定する
exec --no-startup-id feh --bg-fill /usr/share/endeavouros/backgrounds/girl.png

# ディスプレイの電源管理
exec --no-startup-id xset s off dpms 1800 1800 1800  # 30分後にオフ

# デスクトップ通知
exec --no-startup-id /usr/bin/dunst

# その他の自動起動アプリ
exec --no-startup-id ghostty
exec --no-startup-id slack
exec --no-startup-id discord
exec --no-startup-id twitter
exec --no-startup-id youtube
exec --no-startup-id brave

######################
# フローティング設定 #
######################

# フローティングウィンドウのボーダー設定
for_window [class="urxvt"] border pixel 1

# フローティングに設定するアプリ
for_window [class="Yad" instance="yad"] floating enable
for_window [class="Galculator" instance="galculator"] floating enable
for_window [class="Blueberry.py" instance="blueberry.py"] floating enable
for_window [class="Xsane" instance="xsane"] floating enable
for_window [class="Pavucontrol" instance="pavucontrol"] floating enable
for_window [class="qt5ct" instance="qt5ct"] floating enable
for_window [class="Blueberry.py" instance="blueberry.py"] floating enable
for_window [class="Bluetooth-sendto" instance="bluetooth-sendto"] floating enable
for_window [class="Pamac-manager"] floating enable
for_window [window_role="About"] floating enable
for_window [class="floating-term"] floating enable

