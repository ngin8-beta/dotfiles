######################
# キーバインディング #
######################

# ターミナル起動
bindsym $mod+Return exec --no-startup-id ghostty

# フォーカスされたウィンドウのkill
bindsym $mod+q kill

# 終了メニュー
bindsym $mod+Shift+e exec --no-startup-id ~/.config/i3/scripts/powermenu

# 画面ロック
bindsym $mod+l exec --no-startup-id light-locker-command --lock

# i3の設定ファイルのリロード
bindsym $mod+Shift+c reload

# i3の再起動
bindsym $mod+Shift+r restart

# バックライト
bindsym XF86MonBrightnessUp exec --no-startup-id ~/.config/i3/scripts/volume_brightness.sh brightness_up
bindsym XF86MonBrightnessDown exec --no-startup-id ~/.config/i3/scripts/volume_brightness.sh brightness_down

# volume調整
bindsym XF86AudioRaiseVolume exec --no-startup-id ~/.config/i3/scripts/volume_brightness.sh volume_up
bindsym XF86AudioLowerVolume exec --no-startup-id ~/.config/i3/scripts/volume_brightness.sh volume_down

# 細かいボリューム調整
bindsym $mod+XF86AudioRaiseVolume exec --no-startup-id amixer -D pulse sset Master 1%+ && pkill -RTMIN+1 i3blocks
bindsym $mod+XF86AudioLowerVolume exec --no-startup-id amixer -D pulse sset Master 1%- && pkill -RTMIN+1 i3blocks

# ミュート
bindsym XF86AudioMute exec --no-startup-id ~/.config/i3/scripts/volume_brightness.sh volume_mute

# マイクミュート切り替え
bindsym XF86AudioMicMute exec amixer sset Capture toggle

# オーディオコントロール
bindsym XF86AudioPlay exec --no-startup-id playerctl play      # 再生
bindsym XF86AudioPause exec --no-startup-id playerctl pause    # 一時停止
bindsym XF86AudioNext exec --no-startup-id playerctl next      # 次のトラック
bindsym XF86AudioPrev exec --no-startup-id playerctl previous  # 前のトラック

# ヘッドフォンへの音声出力切り替え
bindsym $mod+p exec --no-startup-id /usr/local/bin/switch-audio-port

# スクリーンショット (flameshot)
# Print: 全画面キャプチャ（クリップボードにコピー）
bindsym Print exec --no-startup-id flameshot full -c
# Alt+Print: アクティブウィンドウをキャプチャ
bindsym $Alt+Print exec --no-startup-id flameshot screen -c
# $mod+Shift+s: 選択範囲をキャプチャ（GUI編集モード）
bindsym $mod+Shift+s exec --no-startup-id flameshot gui

# rofi
# 電源メニュー
bindsym $mod+Shift+p exec --no-startup-id ~/.config/i3/scripts/power-profiles

# $mod+d: Rofiのアプリケーションランチャーを起動
bindsym $mod+d exec --no-startup-id rofi -modi drun -show drun \
		-config ~/.config/rofi/rofidmenu.rasi

# $mod+t: Rofiのウィンドウリストを表示
bindsym $mod+t exec --no-startup-id rofi -show window \
		-config ~/.config/rofi/rofidmenu.rasi

# その他のアプリケーション
bindsym $mod+w exec --no-startup-id /usr/bin/brave
